# Node.js >= 22.13. SQLite is stored on persistent local disk.
DATABASE_PATH=./data/claimed.sqlite
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional. Provision a NEW administrator on startup (password >= 12 characters).
# Public registration and renaming NEVER grant administrator rights.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional. All three values are required to enable Stripe checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Do not enable real payments before configuring legal policies and moderation.
ENABLE_PAYMENTS=false
